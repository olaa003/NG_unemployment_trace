  month = jul,
  volume = {13},
  pages = {28--42},
  abstract = {The study investigated monetary policy measures and unemployment in Nigeria. The specific objectives of the study were to: examine the impact of broad money supply on unemployment rate in Nigeria, to determine the impact of monetary policy rate on unemployment rate in Nigeria and to ascertain the impact of exchange rate on unemployment rate in Nigeria.The study adopted ex post facto research design and used time series data sourced from the CBN statistical bulletin using Autoregressive Distributed lag (ARDL) technique to analyze the data. The study found evidence of long run relation among the variables. The major findings are: monetary policy rate (MPR) has significant negative impact on unemployment rate in Nigeria, exchange rate (EXR) has negative impact on unemployment, and the volume of money supply (MSP) has significant positive impact on unemployment in Nigeria. It is concluded that monetary policy management had significant negative impact on unemployment rate. Based on the findings, it recommended that the CBN may consider maintaining the existing liquidity (money supply) in the economy as it provides additional liquidity for credit creation by banks which will keep investment growing and in the long run ease out the unemployment rate, the monetary policy committee (MPC) should streamline the policy outcome focusing on the interest rate, money supply and the foreign exchange, and the CBN may also consider streamlining the foreign exchange market to unify the rate so as to reduce volatility in the system which affects investment decisions and unemployment in the long run.},
  file = {C:\Users\olude\Zotero\storage\T8X8BV9L\Ele et al. - 2024 - Monetary Policy Measures and Unemployment Dynamics in Nigeria.pdf}
}

